name: build, test, audit & deploy vitthalmirji.com site

on:
  push:
    branches: [ master ]
    paths:
      - 'content/**'
      - 'data/**'
      - 'themes/**'
      - 'static/**'
      - 'assets/**'
      - 'layouts/**'
      - 'hugo.toml'
      - 'scripts/deploy-github-pages.sh'
      - '.github/workflows/**'
  pull_request:
    branches: [ master ]
  workflow_dispatch:

permissions:
  contents: write
  actions: write

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: true

jobs:
  resume:
    uses: ./.github/workflows/resume-build-reusable.yml

  deploy:
    if: github.ref == 'refs/heads/master' && github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    needs: resume
    env:
      # InfinityFree deployment is deprecated. Keep the steps for historical reference,
      # but gate them behind a single flag so they never run by default.
      ENABLE_INFINITYFREE_DEPLOY: "false"
    steps:
      - name: 📥 Checkout code with submodules
        uses: actions/checkout@v5
        with:
          submodules: recursive

      - name: Download resume artifact
        uses: actions/download-artifact@v4
        with:
          name: resume-pdf
          path: .

      - name: 🖨️ Build resume PDF (LaTeX)
        run: |
          chmod +x scripts/resume/build.sh
          LATEX_IMAGE=danteev/texlive:latest scripts/resume/build.sh

      - name: Resolve Hugo version
        id: hugo-version
        run: |
          set -euo pipefail
          . ./.github/hugo.env
          echo "HUGO_VERSION=${HUGO_VERSION}"
          echo "HUGO_VERSION=${HUGO_VERSION}" >> "$GITHUB_OUTPUT"

      - name: ⚙️ Setup Hugo
        uses: peaceiris/actions-hugo@v3
        with:
          hugo-version: ${{ steps.hugo-version.outputs.HUGO_VERSION }}
          extended: true

      - name: Setup Node.js
        uses: actions/setup-node@v5
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install Node dependencies
        run: npm ci

      - name: Generate OG images and sync frontmatter
        run: npm run og:sync-frontmatter

      - name: Commit OG sync changes
        run: |
          set -euo pipefail
          if [ -n "$(git status --porcelain -- content/posts)" ]; then
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add content/posts
            git commit -m "chore(og): sync generated images into frontmatter [skip ci]"
            git push
          else
            echo "No OG sync changes to commit."
          fi

      - name: Cache Hugo resources
        uses: actions/cache@v4
        with:
          path: resources/_gen
          key: ${{ runner.os }}-hugores-${{ hashFiles('**/*') }}
          restore-keys: ${{ runner.os }}-hugores-

      - name: 🏗️ Build Hugo site
        run: hugo --gc --minify --cleanDestinationDir

      - name: 🧪 Run sanity tests
        run: npm test

      - name: Install Pagefind and build search index
        run: |
          npx -y pagefind --site public

      - name: 🧹 Cleanup old artifacts
        continue-on-error: true
        uses: actions/github-script@v7
        with:
          script: |
            const days = 7;
            const timestamp = Date.now() - (days * 24 * 60 * 60 * 1000);
            const { data: artifacts } = await github.rest.actions.listArtifactsForRepo({
              owner: context.repo.owner,
              repo: context.repo.repo,
              per_page: 100
            });
            for (const artifact of artifacts.artifacts) {
              if (new Date(artifact.created_at).getTime() < timestamp) {
                console.log(`Deleting artifact: ${artifact.name} (${artifact.id})`);
                await github.rest.actions.deleteArtifact({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  artifact_id: artifact.id
                });
              }
            }

      - name: 📦 Upload to GitHub Pages (gh-pages)
        uses: peaceiris/actions-gh-pages@v3
        with:
          personal_token: ${{ secrets.PERSONAL_TOKEN }}
          publish_dir: ./public
          external_repository: vim89/vim89
          force_orphan: true

      - name: Install system deps (lftp, zip, unzip, curl, openssl)
        if: env.ENABLE_INFINITYFREE_DEPLOY == 'true'
        run: |
          sudo apt-get update
          sudo apt-get install -y lftp zip unzip curl openssl

      - name: 🚀 Package site for InfinityFree
        if: env.ENABLE_INFINITYFREE_DEPLOY == 'true'
        env:
          FTP_HOST: ${{ secrets.FTP_HOST }}
          FTP_USERNAME: ${{ secrets.FTP_USERNAME }}
          FTP_PASSWORD: ${{ secrets.FTP_PASSWORD }}
          DEPLOY_BASE_URL: "https://vitthalmirji.com"
          PART_SIZE_MB: 9
        run: |
          set -euo pipefail
          PUBLIC_DIR=public ./scripts/deploy.sh package

      - name: 📤 Upload chunks + bootstrap to InfinityFree
        if: env.ENABLE_INFINITYFREE_DEPLOY == 'true'
        env:
          FTP_HOST: ${{ secrets.FTP_HOST }}
          FTP_USERNAME: ${{ secrets.FTP_USERNAME }}
          FTP_PASSWORD: ${{ secrets.FTP_PASSWORD }}
          DEPLOY_BASE_URL: "https://vitthalmirji.com"
          PART_SIZE_MB: 9
        run: |
          set -euo pipefail
          PUBLIC_DIR=public ./scripts/deploy.sh upload

      - name: 🔁 Try automatic finalize (curl loop)
        if: env.ENABLE_INFINITYFREE_DEPLOY == 'true'
        continue-on-error: true
        timeout-minutes: 3
        env:
          DEPLOY_BASE_URL: "https://vitthalmirji.com"
          FTP_HOST: ${{ secrets.FTP_HOST }}
          FTP_USERNAME: ${{ secrets.FTP_USERNAME }}
          FTP_PASSWORD: ${{ secrets.FTP_PASSWORD }}
          DEPLOY_TOKEN: ${{ secrets.DEPLOY_TOKEN }}
        run: |
          set -euo pipefail
          ./scripts/deploy.sh finalize

      - name: 📣 Manual extraction fallback
        if: failure() && env.ENABLE_INFINITYFREE_DEPLOY == 'true'
        run: |
          echo "### ⚠️ Finalize deployment manually" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "The automatic extraction failed due to InfinityFree's bot protection." >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "**Required Action:**" >> "$GITHUB_STEP_SUMMARY"
          echo "1. Open **https://vitthalmirji.com/index.deploy.php** in your browser" >> "$GITHUB_STEP_SUMMARY"
          echo "2. Let the page auto-refresh until it displays \"Deployment finished\"" >> "$GITHUB_STEP_SUMMARY"
          echo "3. This usually takes 30-60 seconds" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "Files have been uploaded successfully. Only extraction is pending." >> "$GITHUB_STEP_SUMMARY"

      - name: ✅ Deployment success message (GitHub Pages)
        if: success()
        run: |
          echo "### ✅ Deployment completed successfully (GitHub Pages)" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "Static site published via GitHub Pages artifact." >> "$GITHUB_STEP_SUMMARY"

      - name: ✅ Deployment success message
        if: success() && env.ENABLE_INFINITYFREE_DEPLOY == 'true'
        run: |
          echo "### ✅ Deployment completed successfully" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "Site has been deployed to **https://vitthalmirji.com**" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "The automatic extraction completed without manual intervention." >> "$GITHUB_STEP_SUMMARY"